# Wzór pliku .env. Skopiuj do .env (cp .env.example .env) i ustaw WŁASNE wartości.
# Prawdziwego .env NIGDY nie commituj – jest w .gitignore.
#
# Hasła Postgres, TURN i LLDAP admin są też w synapse/homeserver.yaml (Synapse nie czyta
# zmiennych środowiskowych w configu) – wartości muszą być IDENTYCZNE w obu plikach.
# Losowa wartość (bez znaków specjalnych, bezpieczna dla .env i YAML):  openssl rand -hex 24

# Adres IP Tailscale serwera (tailscale ip -4)
TS_IP=100.x.x.x

# --- Drzewo Spaces (scripts/setup_spaces.py): główny space "Firma" + podprzestrzenie-działy ---
# Nazwa wyświetlana głównego space'u (zmienialna w każdej chwili; wewnętrzny 'id' i alias pozostają stałe).
SPACES_ROOT_NAME=Firma

# Loginy osób, które mogą pisać w space'ach (po przecinku, bez spacji i bez @); poza nimi
# i administratorem space'y są tylko do odczytu. Puste = nikt poza adminem.
# Gdy puste, skrypt bierze listę z MAIN_ROOM_WRITERS (stara nazwa, zachowana dla zgodności).
SPACES_WRITERS=

# Reguła dołączania podprzestrzeni-działów: invite (domyślnie; dział widzą i rozwijają tylko jego
# członkowie) albo knock (działy widoczne dla wszystkich z Firmy, bez list ludzi; sprawdzone
# 2026-10-14 i odrzucone). Główny space jest zawsze invite-only.
SPACES_SUBSPACE_JOIN_RULE=invite

# --- Książka adresowa w pokoju (scripts/setup_directory.py; Etap G, nieprzetestowane) ---
# Wszystkie opcjonalne; wartości poniżej to domyślne (odkomentuj, żeby zmienić).
# Piszący w pokoju: SPACES_WRITERS (wyżej).
# DIRECTORY_ROOM_ALIAS=ksiazka-adresowa
# DIRECTORY_ROOM_NAME=Książka adresowa
# DIRECTORY_ROOM_TOPIC=Kto jest kim w firmie: rozwiń dział i kliknij osobę (tylko do odczytu)
# Loginy pominięte na liście, po przecinku, bez @ (np. administrator i konta techniczne).
# DIRECTORY_EXCLUDE=

POSTGRES_PASSWORD=CHANGE_ME_postgres
TURN_SECRET=CHANGE_ME_turn
LLDAP_ADMIN_PASSWORD=CHANGE_ME_lldap_admin
LLDAP_JWT_SECRET=CHANGE_ME_jwt
LLDAP_KEY_SEED=CHANGE_ME_key_seed

# --- Hasła używane przez skrypty (NIGDY na sztywno w kodzie; skrypty odrzucają wartość CHANGE_ME...) ---
# Hasło konta administratora Synapse (login: ADMIN_LOGIN w scripts/setup_main_room.py; PC).
# Czytają je: setup_main_room.py (biblioteka), setup_spaces.py, setup_directory.py,
# test_directory_message.py, provision_synapse_users.py.
SYNAPSE_ADMIN_PASSWORD=CHANGE_ME_synapse_admin
# Wspólne hasło kont testowych z LLDAP (TYLKO PoC). Czyta je scripts/set_test_passwords.sh NA VM,
# więc musi być w .env NA VM (nie na PC).
TEST_PASSWORD=CHANGE_ME_test_password
