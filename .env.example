# Wzór pliku .env. Skopiuj do .env (cp .env.example .env) i ustaw WŁASNE wartości.
# Prawdziwego .env NIGDY nie commituj – jest w .gitignore.
#
# Hasła Postgres, TURN i LLDAP admin są też w synapse/homeserver.yaml (Synapse nie czyta
# zmiennych środowiskowych w configu) – wartości muszą być IDENTYCZNE w obu plikach.
# Losowa wartość (bez znaków specjalnych, bezpieczna dla .env i YAML):  openssl rand -hex 24

# Adres IP Tailscale serwera (tailscale ip -4)
TS_IP=100.x.x.x

# --- Pokój główny i widget (scripts/setup_main_room.py) ---
# Adres widgetu-ściągi. Musi działać na KAŻDYM kliencie (PC i telefon), po HTTPS.
# W PoC: adres z Tailscale, np. https://<PELNA-NAZWA-TS>/widget/ (nie matrix.local).
# Na produkcji: prawdziwa domena, np. https://matrix.firma.pl/widget/
WIDGET_URL=https://<PELNA-NAZWA-TS>/widget/

# Nazwa pokoju, jego alias (część przed dwukropkiem; małe litery, bez spacji i polskich znaków,
# pełny alias to #alias:matrix.local) i temat. Zmiana nazwy/tematu i ponowne uruchomienie
# skryptu przemianuje istniejący pokój.
MAIN_ROOM_NAME=Firma-Ogłoszenia
MAIN_ROOM_ALIAS=firma-ogloszenia
MAIN_ROOM_TOPIC=Ogłoszenia dla wszystkich pracowników (tylko do odczytu)

# true  = pokój tylko do odczytu (tablica ogłoszeń): czytają wszyscy, piszą admin skryptu i osoby
#         z MAIN_ROOM_WRITERS; reakcje emoji mogą dawać wszyscy.
# false = zwykły pokój, piszą wszyscy.
MAIN_ROOM_READONLY=true

# Loginy osób, które mogą pisać w pokoju tylko do odczytu (po przecinku, bez spacji i bez @).
# Ta lista jest źródłem prawdy: osoba usunięta stąd traci prawo pisania po ponownym uruchomieniu
# skryptu. Przykład: MAIN_ROOM_WRITERS=j.kowalski,a.nowak
MAIN_ROOM_WRITERS=

# Drugi pokoj (tylko do odczytu, te same zasady i lista piszacych): widget-sciaga na cale okno.
# Ten pokoj dostaje widget z WIDGET_URL; pokoj ogloszen (MAIN_ROOM_*) jest BEZ widgetu.
ORG_ROOM_NAME=Struktura organizacyjna
ORG_ROOM_ALIAS=struktura-organizacyjna
ORG_ROOM_TOPIC=Ściąga: kto jest kim w firmie (tylko do odczytu)

POSTGRES_PASSWORD=CHANGE_ME_postgres
TURN_SECRET=CHANGE_ME_turn
LLDAP_ADMIN_PASSWORD=CHANGE_ME_lldap_admin
LLDAP_JWT_SECRET=CHANGE_ME_jwt
LLDAP_KEY_SEED=CHANGE_ME_key_seed
