# Wzór konfiguracji Nginx. Skopiuj do nginx/conf.d/matrix.conf
# (cp nginx/conf.d/matrix.conf.example nginx/conf.d/matrix.conf).
# Dostęp przez nazwę Tailscale (opcjonalny, DOMYŚLNIE WYŁĄCZONY): dwa ostatnie bloki `server` na końcu pliku są
# zakomentowane. Nginx nie czyta tu zmiennych z .env, więc włączasz je ręcznie: patrz README 5.2.
# Prawdziwego matrix.conf nie commituj – jest w .gitignore.

server {
    listen 80;
    server_name matrix.local;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name matrix.local;

    ssl_certificate     /etc/nginx/certs/matrix.crt;
    ssl_certificate_key /etc/nginx/certs/matrix.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 50M;

    # API Matrix -> Synapse
    # UWAGA: /_synapse/admin jest tu CELOWO wlaczone, zeby skrypty prowizjonujace
    # (Etap B, scripts/provision_synapse_users.py) mogly dzialac z PC przez to samo
    # proxy co klienci. Admin API i tak wymaga tokenu konta administratora Synapse
    # (patrz README, Etap B) -- nie jest otwarte "na oscierz", ale w PoC-u wystawione
    # publicznie razem z reszta. Na produkcji rozwazyc ograniczenie np. po IP (allow/deny).
    location ~ ^(/_matrix|/_synapse/client|/_synapse/admin) {
        proxy_pass http://synapse:8008;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }

    # Autodiscovery dla klientów
    location = /.well-known/matrix/client {
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        return 200 '{"m.homeserver":{"base_url":"https://matrix.local"}}';
    }

    location / {
        return 404;
    }
}

# ---------------------------------------------------------------------------
# Synapse Admin (panel WWW, HTTPS). Port 8080 publikuje Docker na adresie ADMIN_BIND i porcie
# ADMIN_PORT z .env (docker-compose.yml; domyślnie tylko 127.0.0.1 VM). Zalecane: ADMIN_BIND =
# adres Tailscale serwera -> panel widzą tylko urządzenia z tailnetu, bez tunelu SSH.
# Ten sam certyfikat co port 443 (SAN = domena), więc adres w przeglądarce to https://<DOMENA>:8080
# (z wpisem <DOMENA> w hosts i zainstalowanym Root CA, tak jak dla Elementa). Przez tunel SSH i
# localhost przeglądarka pokaże ostrzeżenie o nazwie certyfikatu (SAN nie zawiera localhost).
# Panel i API na tym samym originie, dlatego nie ma problemu z CORS.
# W polu serwera w panelu wpisz: https://<DOMENA>:8080
# Admin API (/_synapse/admin) na tym porcie nie ma ograniczenia po IP - na produkcji dodaj allow/deny.
# ---------------------------------------------------------------------------
server {
    listen 8080 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/matrix.crt;
    ssl_certificate_key /etc/nginx/certs/matrix.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location ~ ^(/_matrix|/_synapse/admin) {
        proxy_pass http://synapse:8008;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }

    location / {
        proxy_pass http://synapse-admin:80;
        proxy_set_header Host $host;
    }
}

# ---------------------------------------------------------------------------
# Dostęp przez nazwę MagicDNS z Tailscale (certyfikat Let's Encrypt
# z `tailscale cert`, bez instalowania rootCA na kliencie).
# DOMYŚLNIE WYŁĄCZONE (zakomentowane), bo bez plików .crt/.key Nginx w ogóle się nie uruchomi.
# Żeby włączyć: 1) wygeneruj certyfikat w katalogu certs/:
#   sudo tailscale cert <PELNA-NAZWA-TS>
# 2) odkomentuj poniższe dwa bloki (usuń "# " z początku ich linii, komentarze nad nimi zostaw),
# 3) zamień wszędzie matrix-test.TWOJ-TAILNET.ts.net na <PELNA-NAZWA-TS>
# (server_name, ścieżki certyfikatu, base_url), 4) docker compose restart proxy.
# server_name Synapse nadal = matrix.local; zmienia się tylko adres klienta.
